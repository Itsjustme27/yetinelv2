# Copy to .env and fill in. Never commit .env — it is gitignored.

# Port the API and WebSocket server listen on.
PORT=3001

# "development" includes error messages in 500 responses and keeps the
# /api/ingest/test event generator enabled. Production disables both.
NODE_ENV=development

# Shared secret for the agent ingest API, sent by agents as X-Agent-Key.
# The server refuses ingest requests with 503 until this is set.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_API_KEY=

# Not currently read by any code — reserved, and safe to remove.
JWT_SECRET=
